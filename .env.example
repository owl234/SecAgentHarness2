# Harness2 / SecAgentHarness2 环境配置模板
#
# 用法:
#   cp .env.example .env
#   编辑 .env, 填入你的 API 端点与模型 ID
#   gcloud auth application-default login (若走 Vertex AI)
#
# 注意:
#   - Shell 环境变量优先于本文件 (config.load_dotenv 使用 setdefault)。
#   - 留空的项等同于未设置, 项目会给出对应的提示; 因此未编辑的模板不会被误用。
#   - 本文件只放占位符, 切勿提交真实凭据。.env 已被 .gitignore 忽略。

# ---------------------------------------------------------------------------
# 统一 API 接入 (推荐)
# ---------------------------------------------------------------------------
# 设置下面两项即可同时驱动 OpenCode 与 Pi 执行基座, 无需分别配置。
# 系统会自动按各基座协议完成适配: OpenCode 自动注入 sec_agent_harness2 Provider 块,
# Pi 自动适配 models.json。
#
# SEC_AGENT_HARNESS2_API_BASE_URL=https://your-endpoint.example.com/v1
# SEC_AGENT_HARNESS2_API_KEY=your_api_key
# 统一模型 ID (裸模型 ID, 例如 gemini-2.5-pro, gpt-5.4)
# SEC_AGENT_HARNESS2_API_MODEL=your-model-id
#
# 协议覆盖 (一般无需设置): openai-chat | openai-responses | anthropic
# SEC_AGENT_HARNESS2_API_PROTOCOL=

# ---------------------------------------------------------------------------
# Vertex AI 项目 (使用 google-vertex 路由或 Vertex judge 时才需要)
# ---------------------------------------------------------------------------
# 留空时 sec-agent-harness2 check 会提示 "Set GOOGLE_CLOUD_PROJECT for Vertex AI"。
# 走上面的统一 API 接入时可以不填。
GOOGLE_CLOUD_PROJECT=

# 代码中的默认值即为 global, 一般无需修改。
GOOGLE_CLOUD_LOCATION=global

# 也可用 SEC_AGENT_HARNESS2_VERTEX_PROJECT 作为 GOOGLE_CLOUD_PROJECT 的回退名。
# SEC_AGENT_HARNESS2_VERTEX_PROJECT=

# 若使用服务账号密钥而非 ADC, 取消注释并指向 JSON 文件:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ---------------------------------------------------------------------------
# 模型 ID 与微调
# ---------------------------------------------------------------------------
# OpenCode 执行器 (语法: <provider>/<model>)。Vertex 上必须带 google-vertex/ 前缀,
# 例如 google-vertex/gemini-2.5-pro。走统一 API 时系统会自动合成 sec_agent_harness2/<model>。
SEC_AGENT_HARNESS2_SOLVER_MODEL=

# Pi Coding Agent 执行器的模型 ID (裸模型 ID), 默认取 SOLVER_MODEL 斜杠后的部分。
# SEC_AGENT_HARNESS2_PI_MODEL=

# Pi 执行器的 reasoning effort (low | medium | high), 默认 high。
# SEC_AGENT_HARNESS2_PI_EFFORT=high

# 改进器 (Propose/Compose 通道), 默认复用执行器模型。
# SEC_AGENT_HARNESS2_IMPROVER_MODEL=

# 裁判模型, 使用不带前缀的裸模型 ID, 适配器会自动补 Vertex 前缀。
# WorkBuddy 要求此项为纯 gemini... ID。
# SEC_AGENT_HARNESS2_JUDGE_MODEL=

# ---------------------------------------------------------------------------
# 结果目录
# ---------------------------------------------------------------------------
# 默认为仓库下的 runs/。更换模型或任务范围时请使用新目录。
# SEC_AGENT_HARNESS2_RUNS_DIR=

# ---------------------------------------------------------------------------
# OpenCode 执行器专属覆盖 (--substrate oc)
# ---------------------------------------------------------------------------
# SEC_AGENT_HARNESS2_OPENCODE_BASE_URL=
# SEC_AGENT_HARNESS2_OPENCODE_API_KEY=
# SEC_AGENT_HARNESS2_OPENCODE_PROTOCOL=

# ---------------------------------------------------------------------------
# Pi Coding Agent 执行器专属覆盖 (--substrate pi)
# ---------------------------------------------------------------------------
# SEC_AGENT_HARNESS2_PI_BASE_URL=
# SEC_AGENT_HARNESS2_PI_API_KEY=
# SEC_AGENT_HARNESS2_PI_PROTOCOL=

# ---------------------------------------------------------------------------
# 裁判端点覆盖 (默认复用 Vertex OpenAI 兼容端点)
# ---------------------------------------------------------------------------
# 使用非 Gemini 裁判或外部裁判服务时需要同时设置这两项。
# SEC_AGENT_HARNESS2_JUDGE_BASE_URL=https://your-judge-endpoint/v1
# SEC_AGENT_HARNESS2_JUDGE_API_KEY=your_judge_key

# ---------------------------------------------------------------------------
# 其他
# ---------------------------------------------------------------------------
# 界面语言: zh | en。默认跟随系统 locale。
# SEC_AGENT_HARNESS2_LANG=
